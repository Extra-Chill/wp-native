{
  "name": "wp-native",
  "private": true,
  "description": "Turn any WordPress site into a real native app. Open source. Token auth. No WebViews.",
  "license": "MIT",
  "author": "Chris Huber <chubes@extrachill.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Extra-Chill/wp-native.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test:gutenberg": "npm run test --workspace=wp-native-gutenberg",
    "test:transport": "npm run typecheck && tsx --test packages/api-client/tests/*.test.mjs",
    "typecheck:watch": "tsc -b --watch",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@react-navigation/drawer": "^7.9.9",
    "@react-navigation/native": "^7.2.2",
    "@types/react": "^19.2.14",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
